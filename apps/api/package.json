{
  "name": "@ticket-booking/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node ../../scripts/dev-api.mjs",
    "build": "pnpm --filter @ticket-booking/contracts build && nest build",
    "start": "node dist/main.js",
    "lint": "pnpm --filter @ticket-booking/contracts build && tsc --noEmit",
    "typecheck": "pnpm --filter @ticket-booking/contracts build && tsc --noEmit",
    "test": "dotenv -e ../../.env -- jest --runInBand",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev --skip-generate",
    "prisma:seed": "dotenv -e ../../.env -- prisma db seed",
    "prisma:seed:check": "dotenv -e ../../.env -- ts-node prisma/verify-demo.ts",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-socket.io": "^10.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.4.4",
    "@prisma/client": "^5.20.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@ticket-booking/contracts": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@ticket-booking/tsconfig": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.4",
    "dotenv-cli": "^7.4.4",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "schema": "prisma",
    "seed": "ts-node prisma/seed.ts"
  }
}
