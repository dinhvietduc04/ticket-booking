model Booking {
  id            String        @id @default(uuid())
  bookingNumber String        @unique
  userId        String
  sessionId     String
  holdId        String?       @unique
  subtotal      Int
  serviceFee    Int           @default(0)
  discount      Int           @default(0)
  promotionId   String?
  promotion     Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  refunds       Refund[]
  notifications CustomerNotification[]
  total         Int
  currency      String        @default("VND")
  status        BookingStatus @default(PENDING_PAYMENT)
  expiresAt     DateTime?
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       Session       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  hold          SeatHold?     @relation(fields: [holdId], references: [id], onDelete: SetNull)
  items         BookingItem[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@map("bookings")
}

model BookingItem {
  id            String      @id @default(uuid())
  bookingId     String
  sessionSeatId String
  price         Int
  ticketType    String
  booking       Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sessionSeat   SessionSeat @relation(fields: [sessionSeatId], references: [id], onDelete: Restrict)
  ticket        Ticket?
  createdAt     DateTime    @default(now())

  @@unique([bookingId, sessionSeatId])
  @@index([sessionSeatId])
  @@map("booking_items")
}
