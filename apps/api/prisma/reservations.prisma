model SeatHold {
  id        String         @id @default(uuid())
  userId    String
  sessionId String
  // Snapshot only: queue entries are replaced when a customer rejoins.
  admissionEntryId String?
  expiresAt DateTime
  status    SeatHoldStatus @default(ACTIVE)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  items     SeatHoldItem[]
  booking   Booking?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@index([status, expiresAt])
  @@map("seat_holds")
}

model SeatHoldItem {
  id            String      @id @default(uuid())
  holdId        String
  sessionSeatId String
  price         Int @default(0)
  currency      String @default("VND")
  hold          SeatHold    @relation(fields: [holdId], references: [id], onDelete: Cascade)
  sessionSeat   SessionSeat @relation(fields: [sessionSeatId], references: [id], onDelete: Restrict)

  @@unique([holdId, sessionSeatId])
  @@index([sessionSeatId])
  @@map("seat_hold_items")
}
